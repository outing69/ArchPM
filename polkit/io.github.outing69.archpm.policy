<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>ArchPM</vendor>

  <action id="io.github.outing69.archpm.helper.run">
    <description>Manage processes and memory with ArchPM</description>
    <message>Authentication is required to give a process more priority than a normal user may, to act on processes of other users, to change how eagerly the system uses swap and free its caches, to remove old package versions and old logs, and to list, take and delete filesystem snapshots.</message>
    <icon_name>utilities-system-monitor</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- keep: after entering it once the session stays valid for ~5 minutes -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <!-- @HELPER@ is filled in at install time: /usr/lib/archpm/archpm-helper by the package,
         /usr/local/lib/archpm/archpm-helper by install.sh -->
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER@</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
