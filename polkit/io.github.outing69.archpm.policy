<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>ArchPM</vendor>

  <action id="io.github.outing69.archpm.helper.run">
    <description>Change ArchPM system settings</description>
    <description xml:lang="nl">Systeeminstellingen van ArchPM wijzigen</description>
    <message>Authentication is required to change process priorities, signal other users' processes, start or stop system services, and adjust memory settings. It stays valid for about five minutes.</message>
    <message xml:lang="nl">Authenticatie is vereist om procesprioriteiten te wijzigen, processen van andere gebruikers te signaleren, systeemdiensten te starten of te stoppen en geheugeninstellingen aan te passen. Blijft ongeveer vijf minuten geldig.</message>
    <icon_name>utilities-system-monitor</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- keep: after entering it once the session stays valid for ~5 minutes -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/archpm/archpm-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
