# Maintainer: Alex <https://github.com/outing69>
pkgname=archpm
pkgver=0.2.47
pkgrel=1
pkgdesc="Process manager and monitor for a Linux gaming PC: PySide6 GUI, sampler agent and two Plasma 6 widgets"
arch=('any')
url="https://github.com/outing69/ArchPM"
license=('MIT')
install=archpm.install
depends=('python' 'pyside6' 'python-psutil' 'polkit' 'iproute2')
optdepends=('plasma-desktop: the Monitor and Network widgets'
            'adwaita-icon-theme: the Adwaita icons on the navigation rail'
            'pacman-contrib: clean the package cache from the Cleanup page'
            'nvidia-utils: NVIDIA GPU telemetry via nvidia-smi'
            'hwdata: proper names for AMD GPUs')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
# The source is the commit the release tag's code is at, not the tag's own
# tarball: a tag tarball would contain this PKGBUILD, whose checksum cannot
# be known before the tag exists. Pinned to the commit, the tag can carry the
# PKGBUILD that builds it, so "git checkout vX && makepkg -si" builds X.
_commit=1eb936c0a5286e6a72cc5ce9ac8c9092326bfc94
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('8b01c8c2ee982334c5f6912197396b47e302a57e82fb47c8ad43d3a022d78ab2')

_src="ArchPM-$_commit"
_helper=/usr/lib/archpm/archpm-helper
_plasmoid=io.github.outing69.archpm

build() {
    cd "$_src"
    python -m build --wheel --no-isolation
}

check() {
    cd "$_src"
    python -m unittest discover tests
}

package() {
    cd "$_src"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # The root helper is the only thing that runs as root. It lives outside
    # site-packages, root-owned, so pkexec accepts it and it cannot import
    # anything a user could have modified.
    install -Dm755 archpm/root/helper.py "$pkgdir$_helper"
    sed "s|@HELPER@|$_helper|" "polkit/$_plasmoid.policy" \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/polkit-1/actions/$_plasmoid.policy"

    # systemd --user unit and desktop entry without the checkout paths
    sed -e '/^WorkingDirectory=/d' -e '/^Documentation=/d' \
        -e 's|^ExecStart=.*|ExecStart=/usr/bin/archpm-agent --interval 2|' \
        systemd/archpm-agent.service \
        | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/archpm-agent.service"
    sed -e '/^Path=/d' -e 's|^Exec=.*|Exec=archpm|' archpm.desktop \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/archpm.desktop"

    # Plasma widgets. They start ArchPM by this fixed path and run nothing
    # that comes out of status.json.
    install -d "$pkgdir/usr/share/plasma/plasmoids/$_plasmoid"
    cp -r plasmoid/package/. "$pkgdir/usr/share/plasma/plasmoids/$_plasmoid/"
    install -d "$pkgdir/usr/share/plasma/plasmoids/$_plasmoid.network"
    cp -r plasmoid/network/. "$pkgdir/usr/share/plasma/plasmoids/$_plasmoid.network/"
    sed -i 's|@LAUNCH@|/usr/bin/archpm|' \
        "$pkgdir/usr/share/plasma/plasmoids/$_plasmoid/contents/ui/main.qml" \
        "$pkgdir/usr/share/plasma/plasmoids/$_plasmoid.network/contents/ui/main.qml"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 SECURITY.md "$pkgdir/usr/share/doc/$pkgname/SECURITY.md"
    install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
