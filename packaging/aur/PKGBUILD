# Maintainer: Alex <https://github.com/outing69>
pkgname=archpm
pkgver=0.1.1
pkgrel=1
pkgdesc="Process manager and monitor for a Linux gaming PC: PySide6 GUI, sampler agent and Plasma 6 widget"
arch=('any')
url="https://github.com/outing69/ArchPM"
license=('MIT')
install=archpm.install
depends=('python' 'pyside6' 'python-psutil' 'polkit')
optdepends=('plasma-desktop: desktop widget'
            'nvidia-utils: NVIDIA GPU telemetry via nvidia-smi'
            'hwdata: proper names for AMD GPUs')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e1b6df6e6c8cfcddfbfd588ec7c3528ec9ae22f403bb3fec2ecf3d8c40342637')

_src="ArchPM-$pkgver"
_helper=/usr/lib/archpm/archpm-helper
_plasmoid=io.github.outing69.archpm

build() {
    cd "$_src"
    python -m build --wheel --no-isolation
}

check() {
    cd "$_src"
    python -m unittest discover tests
}

package() {
    cd "$_src"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # The root helper is the only thing that runs as root. It lives outside
    # site-packages, root-owned, so pkexec accepts it and it cannot import
    # anything a user could have modified.
    install -Dm755 archpm/root/helper.py "$pkgdir$_helper"
    sed "s|@HELPER@|$_helper|" "polkit/$_plasmoid.policy" \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/polkit-1/actions/$_plasmoid.policy"

    # systemd --user unit and desktop entry without the checkout paths
    sed -e '/^WorkingDirectory=/d' -e '/^Documentation=/d' \
        -e 's|^ExecStart=.*|ExecStart=/usr/bin/archpm-agent --interval 2|' \
        systemd/archpm-agent.service \
        | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/archpm-agent.service"
    sed -e '/^Path=/d' -e 's|^Exec=.*|Exec=archpm|' archpm.desktop \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/archpm.desktop"

    # Plasma widget
    install -d "$pkgdir/usr/share/plasma/plasmoids/$_plasmoid"
    cp -r plasmoid/package/. "$pkgdir/usr/share/plasma/plasmoids/$_plasmoid/"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 SECURITY.md "$pkgdir/usr/share/doc/$pkgname/SECURITY.md"
}
